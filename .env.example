# Auth/users API (technician-copilot-server), includes /api
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
# copilot-server root (client appends /api/v1). Android emulator: use http://10.0.2.2:3000
EXPO_PUBLIC_COPILOT_BASE_URL=http://localhost:3000
# Optional dev bypass (server must run with ALLOW_DEV_AUTH_BYPASS=true)
# EXPO_PUBLIC_COPILOT_DEV_BYPASS=true
# EXPO_PUBLIC_COPILOT_DEV_USER_ID=
# EXPO_PUBLIC_COPILOT_DEV_USER_EMAIL=
# EXPO_PUBLIC_COPILOT_DEV_USER_ROLE=admin
# EXPO_PUBLIC_COPILOT_DEV_COMPANY_ID=
