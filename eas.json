{
  "cli": { "version": ">= 16.28.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:4000/api",
        "EXPO_PUBLIC_COPILOT_BASE_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false, "buildConfiguration": "Release" },
      "android": { "buildType": "apk" },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": { "simulator": false, "buildConfiguration": "Release" },
      "android": { "buildType": "apk" },
      "environment": "production"
    }
  },
